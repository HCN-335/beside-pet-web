{
  "name": "beside-pet-web",
  "version": "0.1.0",
  "private": true,
  "description": "Pet-loss emotional support agent web client (Next.js)",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "guard": "pdks explain && node dev-tools/docs.mjs check",
    "docs:search": "node dev-tools/docs.mjs search",
    "docs:list": "node dev-tools/docs.mjs list",
    "docs:show": "node dev-tools/docs.mjs show",
    "docs:index": "node dev-tools/docs.mjs index",
    "docs:check": "node dev-tools/docs.mjs check",
    "postinstall": "lefthook install || true"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@polydeukes/adapter-claude-code": "0.9.0",
    "@polydeukes/adapter-codex": "0.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lefthook": "2.1.3",
    "polydeukes": "0.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp"
    ]
  }
}
